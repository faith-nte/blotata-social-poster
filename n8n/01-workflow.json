      "name": "Validate run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const raw=$json.data ?? $json.body ?? $json; const rpc=typeof raw==='string' ? JSON.parse(raw.split('\\n').find(l=>l.startsWith('data: ')).slice(6)) : raw; if(rpc.error || rpc.result?.isError) throw new Error(JSON.stringify(rpc.error || rpc.result)); const d=rpc.result.structuredContent; if(!d?.runId || !d?.storages?.datasets?.default?.id) throw new Error('APIFY_RUN_RESPONSE: '+JSON.stringify(rpc.result)); return [{json:{data:{id:d.runId,defaultDatasetId:d.storages.datasets.default.id}}}];"
      }
    },
