        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"call-actor\",\n    \"arguments\": {\n      \"actor\": \"3C7L8IMQOkq3isV2Y\",\n      \"input\": {\n        \"instagramUrl\": \"{{ $('Record').first().json.fields.ReelURL }}\",\n        \"fastProcessing\": false\n      },\n      \"waitSecs\": 0,\n      \"callOptions\": {\n        \"memory\": 128,\n        \"timeout\": 300,\n        \"maxItems\": 1,\n        \"maxTotalChargeUsd\": 1\n      }\n    }\n  }\n}",
