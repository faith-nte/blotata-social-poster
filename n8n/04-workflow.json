    {
      "id": "fbe35fdd-3d66-463b-aeef-838c6a786860",
      "name": "Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "return ($json.records || []).map(r=>({json:r}));"
      }
    },
    {
      "id": "1d5c664b-70d5-4497-a511-4c5e50744b63",
      "name": "Check video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.heygen.com/v3/videos/'+$json.fields.HeyGenVideoId }}",
        "method": "GET",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 120000
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "HeyGen"
        }
      }
    },
    {
      "id": "b09e813d-2f61-44a9-a93c-adf33ce9a476",
      "name": "Completed video",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const d=$json.data||$json; if(d.status==='failed') throw new Error('HeyGen video failed'); if(d.status!=='completed') return []; if(!d.video_url) throw new Error('Completed video has no URL'); return [{json:d}];"
      }
    },
    {
      "id": "488c157a-e457-4c0e-a805-ee27d04a229b",
      "name": "Save video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.airtable.com/v0/appiq7FM7pHODREYL/tblCKulXNvW47zIsS/' + $('Record').first().json.id }}",
        "method": "PATCH",
        "authentication": "predefinedCredentialType",
        "options": {
          "timeout": 120000
        },
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({fields: {Status:'VideoReady',VideoURL:$json.video_url} }) }}"
      },
      "credentials": {
        "airtableTokenApi": {
          "name": "Airtable Personal Access Token account"
        }
      }
    }
  ],
