      "name": "Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "return ($json.records || []).map(r=>({json:r}));"
      }
    },
    {
      "id": "b060d471-3ca7-4ee5-8d47-0d2431926ce9",
      "name": "Check video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.heygen.com/v3/videos/'+$json.fields.HeyGenVideoId }}",
        "method": "GET",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 120000
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "HeyGen"
        }
      }
    },
    {
      "id": "2d7791f9-c4c1-42a1-bc96-653283e2fcfa",
      "name": "Completed video",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const d=$json.data||$json; if(d.status==='failed') throw new Error('HeyGen video failed'); if(d.status!=='completed') return []; if(!d.video_url) throw new Error('Completed video has no URL'); return [{json:d}];"
      }
    },
    {
      "id": "852b200b-93d8-4faa-8332-86654d708a13",
      "name": "Save video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.airtable.com/v0/appiq7FM7pHODREYL/tblCKulXNvW47zIsS/' + $('Record').first().json.id }}",
        "method": "PATCH",
        "authentication": "predefinedCredentialType",
        "options": {
          "timeout": 120000
        },
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {fields: {Status:'VideoReady',VideoURL:$json.video_url}} }}"
      },
      "credentials": {
        "airtableTokenApi": {
          "name": "Airtable Personal Access Token account"
        }
      }
    }
  ],
