      "parameters": {
        "url": "https://api.airtable.com/v0/appiq7FM7pHODREYL/tblCKulXNvW47zIsS?filterByFormula=AND%28%7BStatus%7D%3D%27Generating%27%2C%7BHeyGenVideoId%7D%21%3D%27%27%29&maxRecords=1",
        "method": "GET",
