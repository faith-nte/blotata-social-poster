      ],
      "parameters": {
        "jsCode": "const s=$json.data?.status; if(['FAILED','TIMED-OUT','ABORTED'].includes(s)) throw new Error('Apify '+s); return s==='SUCCEEDED'?items:[];"
      }
    },
    {
      "id": "31593447-db8a-487a-ab30-d3bcc87d9de9",
      "name": "Read transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.apify.com/v2/datasets/' + $('Record').first().json.fields.ApifyDatasetId + '/items' }}",
