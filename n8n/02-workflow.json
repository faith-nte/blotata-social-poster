    {
      "id": "6685194a-a0c4-46b3-88d4-beb0eb6ac7af",
      "name": "Ready transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const raw=$json.data ?? $json.body ?? $json; const rpc=typeof raw==='string' ? JSON.parse(raw.split('\\n').find(l=>l.startsWith('data: ')).slice(6)) : raw; if(rpc.error || rpc.result?.isError) throw new Error(JSON.stringify(rpc.error || rpc.result)); const body=JSON.parse(rpc.result.contents[0].text); const s=body.data.status; if(['FAILED','TIMED-OUT','ABORTED'].includes(s)) throw new Error('APIFY_RUN_'+s); return s==='SUCCEEDED' ? [{json:body}] : [];"
      }
    },
