    {
      "id": "7c9e2550-6be9-442f-8343-d1ea0a51bdcd",
      "name": "Validate transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const r=items.map(i=>i.json).flat(); const d=r.find(x=>x.status!=='error' && typeof x.transcript==='string' && x.transcript.trim().length>=140); if(!d) throw new Error('NO_USABLE_TRANSCRIPT'); return [{json:d}];"
      }
    },
    {
      "id": "f371008e-52fd-4369-a9aa-aa40c47840d9",
      "name": "Claim drafting",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.airtable.com/v0/appiq7FM7pHODREYL/tblCKulXNvW47zIsS/' + $('Record').first().json.id }}",
        "method": "PATCH",
        "authentication": "predefinedCredentialType",
        "options": {
          "timeout": 120000
        },
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {fields: {Status:'Drafting'}} }}"
      },
      "credentials": {
        "airtableTokenApi": {
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "id": "550a20e8-67ec-49df-8781-3008a161844d",
      "name": "Write draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "url": "https://api.openai.com/v1/chat/completions",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "options": {
          "timeout": 120000
        },
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {model:'gpt-4.1',response_format:{type:'json_object'},messages:[{role:'system',content:\"Rewrite the supplied Instagram transcript into an original UK English talking-head script on the same exact topic and niche. Preserve its useful structure while using fresh examples, preferably private medical practice where appropriate. 60\\u201375 words, at most 1500 characters, no em dash. End with: Hit follow to stay up to date! Caption at most 500 characters and five hashtags. Overlay at most eight words with no emoji and punctuation only ? or !. Do not invent facts. Return a JSON object with Script, Caption and Overlay string keys.\"},{role:'user',content:$('Validate transcript').first().json.transcript}]} }}"
      },
      "credentials": {
        "openAiApi": {
          "name": "OpenAi account"
        }
      }
    },
    {
      "id": "28fb870a-71f8-4000-a265-92a1c2af37f3",
      "name": "Validate draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "jsCode": "const d=JSON.parse($json.choices[0].message.content); for(const k of ['Script','Caption','Overlay']) if(typeof d[k]!=='string'||!d[k].trim()) throw new Error('Missing '+k); if(d.Script.length>1500||d.Caption.length>500||d.Overlay.trim().split(/\\s+/).length>8) throw new Error('Draft exceeds length limits'); return [{json:d}];"
      }
    },
    {
      "id": "8da78b0d-934a-487a-9ad7-5765f1e84d88",
      "name": "Save draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.airtable.com/v0/appiq7FM7pHODREYL/tblCKulXNvW47zIsS/' + $('Record').first().json.id }}",
        "method": "PATCH",
        "authentication": "predefinedCredentialType",
        "options": {
          "timeout": 120000
        },
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {fields: {Status:'Draft',Script:$json.Script,Caption:$json.Caption,Overlay:$json.Overlay,Approved:false}} }}"
      },
      "credentials": {
        "airtableTokenApi": {
          "name": "Airtable Personal Access Token account"
        }
      }
    }
