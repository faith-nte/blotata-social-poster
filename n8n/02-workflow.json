    {
      "id": "c7662c7d-7bfe-4b16-8367-4c214e8490d7",
      "name": "Write draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "url": "https://api.openai.com/v1/chat/completions",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "options": {
          "timeout": 120000
        },
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({model:'gpt-4.1',response_format:{type:'json_object'},messages:[{role:'system',content:\"Rewrite the supplied Instagram transcript into an original UK English talking-head script on the same exact topic and niche. Preserve its useful structure while using fresh examples, preferably private medical practice where appropriate. 60\\u201375 words, at most 1500 characters, no em dash. End with: Hit follow to stay up to date! Caption at most 500 characters and five hashtags. Overlay at most eight words with no emoji and punctuation only ? or !. Do not invent facts. Return a JSON object with Script, Caption and Overlay string keys.\"},{role:'user',content:$('Validate transcript').first().json.transcript}]}) }}"
      },
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "eb763558-d0fe-42e0-bf6d-9552569a8842",
      "name": "Validate draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "jsCode": "const d=JSON.parse($json.choices[0].message.content); for(const k of ['Script','Caption','Overlay']) if(typeof d[k]!=='string'||!d[k].trim()) throw new Error('Missing '+k); if(d.Script.length>1500||d.Caption.length>500||d.Overlay.trim().split(/\\s+/).length>8) throw new Error('Draft exceeds length limits'); return [{json:d}];"
      }
    },
    {
      "id": "b5b6598d-e58a-4389-9ad7-6460665d01bd",
      "name": "Save draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        0
      ],
