    {
      "id": "9a279199-accd-4132-b2eb-ba4c25cd040c",
      "name": "Validate transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const raw=$json.data ?? $json.body ?? $json; const rpc=typeof raw==='string' ? JSON.parse(raw.split('\\n').find(l=>l.startsWith('data: ')).slice(6)) : raw; if(rpc.error || rpc.result?.isError) throw new Error(JSON.stringify(rpc.error || rpc.result)); const r=JSON.parse(rpc.result.contents[0].text); const d=r.find(x=>x.status!=='error' && typeof x.transcript==='string' && x.transcript.trim().length>=140); if(!d) throw new Error('NO_USABLE_TRANSCRIPT'); return [{json:d}];"
      }
    },
