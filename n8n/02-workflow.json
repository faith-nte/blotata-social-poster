        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"resources/read\",\n  \"params\": {\n    \"uri\": \"https://api.apify.com/v2/actor-runs/{{ $('Record').first().json.fields.ApifyRunId }}\"\n  }\n}",
